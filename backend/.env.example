# MiniLedger Backend Environment Variables

PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Examples:
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/miniledger?schema=public
# Docker: postgresql://miniledger:miniledger123@localhost:5432/miniledger?schema=public
# Supabase/Neon: postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miniledger?schema=public"

# JWT Secret for Auth Tokens
JWT_SECRET="miniledger_super_secret_jwt_key_2026_dev"
JWT_EXPIRES_IN="7d"

# Mock OTP Expiry in minutes
OTP_EXPIRY_MINUTES=10

# Base URL for static file uploads
APP_BASE_URL="http://localhost:5000"
